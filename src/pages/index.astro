---
const site = {
  "title": "ClaimGraph",
  "description": "ClaimGraph is a private-by-default evidence and report intelligence system for verified legal professionals, with immutable originals, provenance, OCR, redaction, and reviewable analysis.",
  "org": "ClaimGraph",
  "mark": "CG/EVIDENCE",
  "status": "Private evidence intelligence",
  "layout": "ledger",
  "tone": "dark",
  "palette": {
    "paper": "#131716",
    "ink": "#eee9dc",
    "muted": "#a3a69f",
    "accent": "#c0a66c",
    "rule": "#343a37"
  }
};
const capabilities = [
  [
    "Immutable source",
    "Keep originals intact while derivatives carry hashes and lineage."
  ],
  [
    "Reviewable intelligence",
    "Use extraction and retrieval to assist analysis without replacing judgment."
  ],
  [
    "Controlled access",
    "Separate verified professional access, matter boundaries, and administrative authority."
  ]
];
const sequence = [
  [
    "01",
    "Preserve",
    "Register the original in durable object storage."
  ],
  [
    "02",
    "Derive",
    "Extract, redact, and relate material with provenance receipts."
  ],
  [
    "03",
    "Review",
    "Let a qualified professional decide what the record supports."
  ]
];
const visualItems = [
  [
    "original",
    "sealed"
  ],
  [
    "OCR",
    "derived · v3"
  ],
  [
    "redaction",
    "counsel reviewed"
  ],
  [
    "citation",
    "linked"
  ]
];
const audiences = [
  {
    label: "Individual",
    compactLabel: "User",
    href: "https://user.claimgraph.us/"
  },
  {
    label: "Organization",
    compactLabel: "Org",
    href: "https://org.claimgraph.us/"
  }
];
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://claimgraph.github.io");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content={site.palette.paper} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <title>{site.title} — Private evidence intelligence</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main
      id="main"
      class:list={["site", `layout-${site.layout}`, `tone-${site.tone}`]}
      style={`--paper:${site.palette.paper};--ink:${site.palette.ink};--muted:${site.palette.muted};--accent:${site.palette.accent};--rule:${site.palette.rule}`}
    >
      <header class="masthead fleet-nav-enhanced">
        <a class="identity" href="/" aria-label={`${site.title} home`}>
          <span class="mark">{site.mark}</span>
          <span>{site.title}</span>
        </a>
        <div class="header-navigation">
          <nav class="site-nav fleet-desktop-nav" aria-label="Primary navigation">
            <a href="#principles">Principles</a>
            <a href="#method">Method</a>
            <a href={`https://github.com/${site.org}`}>GitHub <span aria-hidden="true">↗</span></a>
          <a href="#access">Access</a><a href="https://user.claimgraph.github.io/">Log in</a><a href="https://auth.claimgraph.github.io/">Sign up</a></nav><details class="fleet-mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation"><a href="#access">Access</a><a href="https://user.claimgraph.github.io/">User log in</a><a href="https://org.claimgraph.github.io/">Organization access</a><a href="https://auth.claimgraph.github.io/">Sign up</a><a href="https://github.com/ClaimGraph">Source</a></nav></details>
          <nav class="audience-switcher" aria-label="Open ClaimGraph application">
            <span class="audience-label">Open as</span>
            {audiences.map(({ label, compactLabel, href }) => (
              <a href={href} aria-label={`Open the ClaimGraph ${label.toLowerCase()} application`}>
                <span class="audience-full">{label}</span>
                <span class="audience-compact" aria-hidden="true">{compactLabel}</span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        </div>
      </header>

      <section class="hero" aria-labelledby="headline">
        <div class="hero-copy">
          <p class="eyebrow">{site.status}</p>
          <h1 id="headline">Evidence that keeps its history.</h1>
          <p class="introduction">Case material changes form as it is ingested, extracted, redacted, related, and cited. ClaimGraph preserves immutable originals and records every derivative so a professional can inspect how an assertion reached the page.</p>
          <div class="hero-actions">
            <a class="primary-link" href={`https://github.com/${site.org}`}>Inspect the evidence model <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#principles">Read the premise <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <aside class="instrument" aria-label="EVIDENCE CHAIN">
          <div class="instrument-head">
            <span>EVIDENCE CHAIN</span>
            <span class="live-dot" aria-hidden="true"></span>
          </div>
          <p class="instrument-code">matter/CG-041</p>
          <div class="instrument-visual" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <dl>
            {visualItems.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </section>

      <section class="thesis" aria-label="Project thesis">
        <p>Software can organize evidence. It must not pretend to adjudicate truth.</p>
        <span>Immutable originals · provenance · review · private by default</span>
      </section>

      <section class="principles" id="principles" aria-labelledby="principles-title">
        <div class="section-heading">
          <p class="section-number">01 / PRINCIPLES</p>
          <h2 id="principles-title">What the system protects.</h2>
        </div>
        <div class="principle-list">
          {capabilities.map(([title, copy], index) => (
            <article>
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="method" id="method" aria-labelledby="method-title">
        <div class="section-heading">
          <p class="section-number">02 / METHOD</p>
          <h2 id="method-title">A visible sequence.</h2>
        </div>
        <ol>
          {sequence.map(([number, title, copy]) => (
            <li>
              <span>{number}</span>
              <div>
                <h3>{title}</h3>
                <p>{copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="closing" aria-label="Closing statement">
        <p>The graph can reveal relationships. The accountable human makes the claim.</p>
        <a href={`https://github.com/${site.org}`}>github.com/{site.org} <span aria-hidden="true">↗</span></a>
      </section>

      <footer>
        <span>{site.mark}</span>
        <span>Built in the open with Astro.</span>
        <span>{new Date().getFullYear()}</span>
      </footer>

<section class="fleet-access" id="access" aria-labelledby="fleet-access-title"><div class="fleet-access-head"><p class="fleet-access-kicker">Product access</p><h2 id="fleet-access-title">Public context here. Account work in the right application.</h2><p class="fleet-access-intro">ClaimGraph's marketing site remains public. Authenticated claim research, evidence review, and argument analysis is separated into individual, organization, and account-creation boundaries.</p></div><div class="fleet-access-grid"><article><span>INDIVIDUAL</span><h3>Your workspace</h3><p>Return to personal activity, saved context, and work owned by your account.</p><a href="https://user.claimgraph.github.io/">User log in ↗</a></article><article><span>ORGANIZATION</span><h3>Team operations</h3><p>Open shared membership, policy, and organization-scoped work.</p><a href="https://org.claimgraph.github.io/">Organization access ↗</a></article><article><span>SHARED AUTH</span><h3>Create an account</h3><p>Start through the dedicated authentication boundary before entering the product.</p><a href="https://auth.claimgraph.github.io/">Sign up ↗</a></article></div></section>
</main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; background: #131716; }
  :global(body) { margin: 0; background: #131716; color: #eee9dc; }
  :global(::selection) { background: #c0a66c; color: #131716; }
  :global(a) { color: inherit; }
  :global(:focus-visible) { outline: 3px solid #c0a66c; outline-offset: 4px; }
  .skip-link {
    position: fixed; left: 1rem; top: 1rem; z-index: 20; padding: .75rem 1rem;
    background: var(--ink); color: var(--paper); transform: translateY(-180%);
  }
  .skip-link:focus { transform: none; }
  .site {
    --sans: "Avenir Next", Avenir, "Segoe UI", sans-serif;
    --serif: Iowan Old Style, "Palatino Linotype", Palatino, Georgia, serif;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    min-height: 100vh; overflow: clip; background: var(--paper); color: var(--ink);
    font-family: var(--sans);
  }
  .masthead {
    position: sticky; top: 0; z-index: 10;
    min-height: 5.5rem; display: flex; align-items: center; justify-content: space-between;
    gap: 2rem; padding: .85rem 4vw; border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
  }
  .identity { display: inline-flex; align-items: center; gap: .9rem; text-decoration: none; font-weight: 650; letter-spacing: -.02em; }
  .mark { font-family: var(--mono); font-size: .7rem; letter-spacing: .08em; color: var(--accent); }
  .header-navigation { display: flex; align-items: center; justify-content: flex-end; gap: clamp(1rem, 2.5vw, 2.5rem); }
  .site-nav { display: flex; gap: clamp(.8rem, 2vw, 2rem); font-family: var(--mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; }
  .site-nav a { text-decoration: none; padding: .7rem 0; border-bottom: 1px solid transparent; }
  .site-nav a:hover { border-color: var(--accent); }
  .audience-switcher {
    display: flex; align-items: stretch; border: 1px solid var(--rule);
    font: 700 .64rem/1 var(--mono); letter-spacing: .07em; text-transform: uppercase;
  }
  .audience-label { display: inline-flex; align-items: center; padding: 0 .8rem; color: var(--muted); white-space: nowrap; }
  .audience-switcher a {
    display: inline-flex; min-height: 2.55rem; align-items: center; justify-content: center; gap: .45rem;
    padding: .75rem .85rem; border-left: 1px solid var(--rule); text-decoration: none; white-space: nowrap;
    transition: background-color 140ms ease, color 140ms ease;
  }
  .audience-switcher a:hover { background: var(--accent); color: var(--paper); }
  .audience-compact { display: none; }
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr);
    min-height: 42rem; border-bottom: 1px solid var(--rule);
  }
  .hero-copy {
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(4.5rem, 9vw, 9rem) clamp(2rem, 7vw, 8rem) clamp(4.5rem, 8vw, 7rem) 4vw;
    border-right: 1px solid var(--rule);
  }
  .eyebrow, .section-number {
    margin: 0 0 2rem; color: var(--accent); font: 700 .68rem/1.4 var(--mono);
    letter-spacing: .12em; text-transform: uppercase;
  }
  h1 {
    max-width: 13ch; margin: 0; font: 500 clamp(3rem, 6.2vw, 6.8rem)/.94 var(--serif);
    letter-spacing: -.055em; text-wrap: balance;
  }
  .layout-console h1, .layout-field h1 { font-family: var(--sans); font-weight: 620; letter-spacing: -.065em; }
  .layout-signal h1 { max-width: 11ch; font-style: italic; }
  .layout-calendar h1 { max-width: 10ch; }
  .layout-studio h1 { max-width: 12ch; font-weight: 400; }
  .introduction {
    max-width: 43rem; margin: 2.25rem 0 0; color: var(--muted);
    font-size: clamp(1.02rem, 1.4vw, 1.25rem); line-height: 1.7;
  }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 2.75rem; }
  .primary-link {
    display: inline-flex; align-items: center; gap: .75rem; padding: .9rem 1.1rem;
    background: var(--ink); color: var(--paper); text-decoration: none;
    font: 700 .73rem/1 var(--mono); letter-spacing: .05em; text-transform: uppercase;
  }
  .primary-link:hover { background: var(--accent); }
  .text-link { color: var(--muted); font: .75rem/1 var(--mono); text-decoration-thickness: 1px; text-underline-offset: .3rem; }
  .instrument {
    position: relative; align-self: center; margin: clamp(2rem, 6vw, 6rem) 4vw;
    border: 1px solid var(--rule); background: var(--paper);
  }
  .instrument::before, .instrument::after {
    content: ""; position: absolute; width: 1rem; height: 1rem;
  }
  .instrument::before { left: -.35rem; top: -.35rem; border-left: 1px solid var(--accent); border-top: 1px solid var(--accent); }
  .instrument::after { right: -.35rem; bottom: -.35rem; border-right: 1px solid var(--accent); border-bottom: 1px solid var(--accent); }
  .instrument-head {
    display: flex; justify-content: space-between; align-items: center; padding: .8rem 1rem;
    border-bottom: 1px solid var(--rule); color: var(--muted);
    font: 700 .65rem/1 var(--mono); letter-spacing: .12em;
  }
  .live-dot { width: .45rem; height: .45rem; background: var(--accent); border-radius: 50%; }
  .instrument-code { margin: 0; padding: 1.5rem 1rem .5rem; color: var(--accent); font: .74rem/1.5 var(--mono); }
  .instrument dl { margin: 0; padding: 1rem; }
  .instrument dl div {
    display: grid; grid-template-columns: 1fr auto; gap: 1rem; padding: .85rem 0;
    border-top: 1px solid var(--rule); font-family: var(--mono);
  }
  .instrument dt { color: var(--muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; }
  .instrument dd { margin: 0; font-size: .78rem; }
  .instrument-visual { height: 8rem; display: flex; align-items: end; gap: .45rem; padding: 1rem; border-bottom: 1px solid var(--rule); }
  .instrument-visual span { flex: 1; height: 44%; border-top: 2px solid var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .instrument-visual span:nth-child(2) { height: 66%; }
  .instrument-visual span:nth-child(3) { height: 35%; }
  .instrument-visual span:nth-child(4) { height: 88%; }
  .instrument-visual span:nth-child(5) { height: 57%; }
  .instrument-visual span:nth-child(6) { height: 74%; }
  .instrument-visual span:nth-child(7) { height: 48%; }
  .layout-ledger .instrument-visual { display: grid; grid-template-columns: repeat(4, 1fr); align-items: center; }
  .layout-ledger .instrument-visual span { height: .75rem; border: 1px solid var(--accent); background: transparent; }
  .layout-ledger .instrument-visual span + span { position: relative; }
  .layout-ledger .instrument-visual span + span::before { content: ""; position: absolute; width: calc(100% + .9rem); border-top: 1px solid var(--rule); right: 100%; top: 50%; }
  .layout-ledger .instrument-visual span:nth-child(n+5) { display: none; }
  .layout-field .instrument-visual { height: 12rem; display: grid; place-items: center; position: relative; }
  .layout-field .instrument-visual span { position: absolute; width: 1px; height: 100%; background: var(--rule); border: 0; }
  .layout-field .instrument-visual span:nth-child(2) { width: 100%; height: 1px; }
  .layout-field .instrument-visual span:nth-child(3) { width: 6rem; height: 6rem; border: 1px solid var(--accent); border-radius: 50%; background: transparent; }
  .layout-field .instrument-visual span:nth-child(4) { width: .65rem; height: .65rem; background: var(--accent); border-radius: 50%; }
  .layout-field .instrument-visual span:nth-child(n+5) { display: none; }
  .layout-calendar .instrument-visual { align-items: stretch; height: 7rem; }
  .layout-calendar .instrument-visual span { height: auto; border-top: 0; border-left: 1px solid var(--rule); background: transparent; }
  .layout-calendar .instrument-visual span:nth-child(5) { border-left-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .layout-studio .instrument-visual { height: 10rem; align-items: center; justify-content: center; }
  .layout-studio .instrument-visual span { flex: 0 0 1px; height: 100%; background: var(--rule); border: 0; transform: rotate(28deg); }
  .thesis {
    display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 3rem;
    padding: clamp(3rem, 7vw, 6rem) 4vw; border-bottom: 1px solid var(--rule);
  }
  .thesis p { max-width: 28ch; margin: 0; font: 400 clamp(1.8rem, 3.6vw, 4rem)/1.1 var(--serif); letter-spacing: -.035em; }
  .thesis span { max-width: 24rem; color: var(--muted); font: .7rem/1.7 var(--mono); text-align: right; text-transform: uppercase; letter-spacing: .08em; }
  .principles, .method { display: grid; grid-template-columns: minmax(14rem, .55fr) minmax(0, 1.45fr); border-bottom: 1px solid var(--rule); }
  .section-heading { padding: clamp(3rem, 6vw, 6rem) 4vw; border-right: 1px solid var(--rule); }
  .section-heading h2 { max-width: 9ch; margin: 0; font: 450 clamp(2rem, 3vw, 3.5rem)/1 var(--serif); letter-spacing: -.04em; }
  .principle-list { display: grid; grid-template-columns: repeat(3, 1fr); }
  .principle-list article { min-height: 21rem; padding: clamp(2rem, 4vw, 4rem) 2.5vw; border-right: 1px solid var(--rule); }
  .principle-list article:last-child { border-right: 0; }
  .principle-list article > span { color: var(--accent); font: .68rem/1 var(--mono); }
  h3 { margin: 3rem 0 1rem; font-size: 1.15rem; line-height: 1.2; letter-spacing: -.02em; }
  .principle-list p, .method li p { margin: 0; color: var(--muted); line-height: 1.65; }
  .method ol { list-style: none; margin: 0; padding: 0; }
  .method li { display: grid; grid-template-columns: 5rem 1fr; padding: 2.25rem 3vw; border-bottom: 1px solid var(--rule); }
  .method li:last-child { border-bottom: 0; }
  .method li > span { color: var(--accent); font: .7rem/1 var(--mono); padding-top: .2rem; }
  .method h3 { margin: 0 0 .65rem; }
  .closing { padding: clamp(5rem, 10vw, 10rem) 4vw 4rem; }
  .closing p { max-width: 23ch; margin: 0 0 4rem; font: 400 clamp(2.25rem, 5vw, 5.5rem)/.98 var(--serif); letter-spacing: -.05em; }
  .closing a { font: .72rem/1 var(--mono); text-underline-offset: .35rem; }
  footer {
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; padding: 1.25rem 4vw;
    border-top: 1px solid var(--rule); color: var(--muted); font: .65rem/1.4 var(--mono);
    text-transform: uppercase; letter-spacing: .08em;
  }
  footer span:last-child { text-align: right; }
  @media (max-width: 900px) {
    .masthead { align-items: flex-start; }
    .header-navigation { flex-direction: column-reverse; align-items: flex-end; gap: .4rem; }
    .audience-label { display: none; }
    .audience-switcher a:first-of-type { border-left: 0; }
    .site-nav { gap: 1.25rem; }
    .hero { grid-template-columns: 1fr; }
    .hero-copy { border-right: 0; border-bottom: 1px solid var(--rule); }
    .instrument { width: min(38rem, calc(100% - 8vw)); justify-self: center; }
    .principles, .method { grid-template-columns: 1fr; }
    .section-heading { border-right: 0; border-bottom: 1px solid var(--rule); }
    .principle-list article { min-height: auto; }
  }
  @media (max-width: 680px) {
    .masthead { display: grid; grid-template-columns: 1fr; gap: .7rem; padding-block: .85rem; }
    .header-navigation { width: 100%; display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: .75rem; }
    .site-nav { gap: .9rem; font-size: .59rem; }
    .site-nav a { padding: .45rem 0; }
    .audience-switcher { width: 100%; }
    .audience-switcher a { flex: 1; min-width: 0; padding-inline: .5rem; }
    .audience-full { display: none; }
    .audience-compact { display: inline; }
    .hero { min-height: 0; }
    .hero-copy { padding: 4.5rem 4vw; }
    h1 { font-size: clamp(2.9rem, 15vw, 5rem); }
    .thesis { grid-template-columns: 1fr; align-items: start; }
    .thesis span { text-align: left; }
    .principle-list { grid-template-columns: 1fr; }
    .principle-list article { border-right: 0; border-bottom: 1px solid var(--rule); padding: 2.5rem 4vw; }
    .principle-list article:last-child { border-bottom: 0; }
    footer { grid-template-columns: 1fr; }
    footer span:last-child { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    :global(*) { transition: none !important; }
  }
</style>

<style>
  .fleet-nav-enhanced { position: sticky !important; top: 0; z-index: 200; isolation: isolate; }
  .fleet-mobile-nav { display: none; position: relative; margin-left: auto; }
  .fleet-mobile-nav summary { cursor: pointer; list-style: none; padding: .62rem .8rem; border: 1px solid currentColor; border-radius: .45rem; font: 700 .72rem/1 system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; }
  .fleet-mobile-nav summary::-webkit-details-marker { display: none; }
  .fleet-mobile-nav nav { position: absolute; right: 0; top: calc(100% + .55rem); min-width: 15rem; display: grid; gap: .25rem; padding: .75rem; background: #111827; color: #fff; border: 1px solid rgba(255,255,255,.18); box-shadow: 0 1.4rem 3rem rgba(0,0,0,.3); }
  .fleet-mobile-nav a { padding: .7rem .8rem; color: inherit; text-decoration: none; }
  @media (max-width: 760px) {
    .fleet-desktop-nav { display: none !important; }
    .fleet-mobile-nav { display: block; }
  }
</style>

<style>
  .fleet-access { padding: clamp(3.5rem, 8vw, 7rem) max(4vw, calc((100% - 76rem) / 2)); border-block: 1px solid currentColor; }
  .fleet-access-head { max-width: 48rem; }
  .fleet-access-kicker { margin: 0 0 .8rem; font: 750 .72rem/1.4 ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; opacity: .7; }
